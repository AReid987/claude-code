    """
```

## Error Handling

### Specific Exception Types

Use specific exception types and provide meaningful error messages:

```python
def load_config(config_path: Path) -> dict[str, str]:
    """Load configuration from JSON file."""
    try:
        with open(config_path, 'r') as f:
            config = json.load(f)
    except FileNotFoundError:
        raise FileNotFoundError(f"Configuration file not found: {config_path}")
    except json.JSONDecodeError as e:
        raise ValueError(f"Invalid JSON in config file {config_path}: {e}")
    except PermissionError:
        raise PermissionError(f"Permission denied reading config file: {config_path}")

    return config
```

### Logging Instead of Silent Failures

Always log errors and use appropriate log levels:

```python
import logging
from pathlib import Path

logger = logging.getLogger(__name__)

def safe_file_operation(file_path: Path) -> bool:
    """Safely perform file operation with proper error handling."""
    try:
        # Perform operation
        return True
    except Exception as e:
        logger.error(f"File operation failed for {file_path}: {e}")
        return False
```

### Module-Specific Logging for Hook Systems

Each hook module should have its own logger and log file to prevent conflicts:

```python
import logging
from pathlib import Path

def setup_module_logger(module_name: str, log_file: Path | None = None) -> logging.Logger:
    """Set up a module-specific logger with file handler.

    Args:
        module_name: Name of the module (e.g., 'hooks.voice_notifications')
        log_file: Path to log file (defaults to module_debug.log in same directory)

    Returns:
        Configured logger instance.
    """
    logger = logging.getLogger(module_name)

    if logger.handlers:
        return logger  # Already configured

    if log_file is None:
        log_file = Path(__file__).parent / f"{module_name.split('.')[-1]}_debug.log"

    # Create file handler
    handler = logging.FileHandler(log_file, mode='a', encoding='utf-8')
    formatter = logging.Formatter(
        '%(asctime)s - %(name)s - %(levelname)s - %(message)s',
        datefmt='%Y-%m-%d %H:%M:%S'
    )
    handler.setFormatter(formatter)

    logger.addHandler(handler)
    logger.setLevel(logging.DEBUG)

    return logger

# Usage in hook modules
logger = setup_module_logger('hooks.voice_notifications')

def process_hook_event(event_data: dict[str, str]) -> None:
    """Process hook event with proper logging."""
    logger.info(f"Processing hook event: {event_data.get('hook_event_name')}")
    try:
        # Process event
        logger.debug(f"Event processed successfully")
    except Exception as e:
        logger.error(f"Hook processing failed: {e}")
```

