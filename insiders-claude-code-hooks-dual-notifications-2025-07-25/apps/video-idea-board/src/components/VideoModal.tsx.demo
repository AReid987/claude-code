import React from 'react';
import { VideoCard as VideoCardType } from '../types';

interface VideoModalProps {
  video: VideoCardType | null;
  isOpen: boolean;
  onClose: () => void;
}

/**
 * Modal component for displaying detailed video information
 * Features elegant backdrop blur and smooth animations
 * (This component will be implemented during the demo)
 */
const VideoModal: React.FC<VideoModalProps> = ({ video, isOpen, onClose }) => {
  if (!isOpen || !video) return null;

  return (
    <div 
      className="modal-backdrop"
      style={{
        position: 'fixed',
        top: 0,
        left: 0,
        right: 0,
        bottom: 0,
        background: 'rgba(0, 0, 0, 0.7)',
        backdropFilter: 'blur(10px)',
        display: 'flex',
        justifyContent: 'center',
        alignItems: 'center',
        zIndex: 1000,
        padding: '20px'
      }}
      onClick={onClose}
    >
      <div 
        className="modal-content"
        style={{
          background: 'linear-gradient(135deg, rgba(255, 255, 255, 0.95), rgba(255, 255, 255, 0.85))',
          borderRadius: '24px',
          padding: '32px',
          maxWidth: '600px',
          width: '100%',
          maxHeight: '80vh',
          overflowY: 'auto',
          boxShadow: '0 24px 64px rgba(0, 0, 0, 0.3)',
          color: '#333',
          transform: 'scale(1)',
          animation: 'modalAppear 0.3s ease-out'
        }}
        onClick={(e) => e.stopPropagation()}
      >
        {/* Modal header */}
        <div style={{ textAlign: 'center', marginBottom: '24px' }}>
          <div style={{ fontSize: '3rem', marginBottom: '12px' }}>
            {video.emoji}
          </div>
          <h2 style={{ 
            margin: '0 0 8px 0', 
            fontSize: '1.8rem',
            color: '#333'
          }}>
            {video.title}
          </h2>
          <p style={{ 
            margin: '0', 
            fontSize: '1.1rem', 
            color: '#666',
            fontStyle: 'italic'
          }}>
            {video.description}
          </p>
        </div>

        {/* Video details */}
        <div style={{ marginBottom: '24px' }}>
          <p style={{ 
            lineHeight: '1.6', 
            fontSize: '1rem',
            marginBottom: '20px',
            color: '#444'
          }}>
            {video.details.fullDescription}
          </p>

          {/* Key features */}
          <h3 style={{ 
            margin: '0 0 12px 0', 
            fontSize: '1.3rem',
            color: '#333'
          }}>
            What You'll Learn:
          </h3>
          <ul style={{ 
            marginBottom: '20px',
            paddingLeft: '20px'
          }}>
            {video.details.keyFeatures.map((feature, index) => (
              <li key={index} style={{ 
                marginBottom: '8px',
                lineHeight: '1.5',
                color: '#555'
              }}>
                {feature}
              </li>
            ))}
          </ul>

          {/* Duration and chapters */}
          {video.details.duration && (
            <div style={{ 
              background: 'rgba(102, 126, 234, 0.1)',
              padding: '12px 16px',
              borderRadius: '12px',
              marginBottom: '16px'
            }}>
              <strong style={{ color: '#333' }}>Duration:</strong> {video.details.duration}
            </div>
          )}

          {video.details.chapters && video.details.chapters.length > 0 && (
            <div style={{ marginBottom: '20px' }}>
              <h4 style={{ 
                margin: '0 0 8px 0',
                fontSize: '1.1rem',
                color: '#333'
              }}>
                Chapters:
              </h4>
              <div style={{ fontSize: '0.9rem', color: '#555' }}>
                {video.details.chapters.slice(0, 4).map((chapter, index) => (
                  <div key={index} style={{ marginBottom: '4px' }}>
                    {chapter}
                  </div>
                ))}
                {video.details.chapters.length > 4 && (
                  <div style={{ fontStyle: 'italic', color: '#777' }}>
                    + {video.details.chapters.length - 4} more chapters...
                  </div>
                )}
              </div>
            </div>
          )}
        </div>

        {/* Action buttons */}
        <div style={{ 
          display: 'flex', 
          gap: '12px',
          justifyContent: 'center',
          flexWrap: 'wrap'
        }}>
          {video.details.youtubeUrl && (
            <a 
              href={video.details.youtubeUrl}
              target="_blank"
              rel="noopener noreferrer"
              style={{
                background: 'linear-gradient(135deg, #ff0000, #cc0000)',
                color: 'white',
                padding: '12px 24px',
                borderRadius: '24px',
                textDecoration: 'none',
                fontWeight: 'bold',
                fontSize: '0.9rem',
                transition: 'transform 0.2s ease'
              }}
              onMouseEnter={(e) => {
                e.currentTarget.style.transform = 'translateY(-2px)';
              }}
              onMouseLeave={(e) => {
                e.currentTarget.style.transform = 'translateY(0)';
              }}
            >
              📺 Watch on YouTube
            </a>
          )}
          
          {video.details.builderPackUrl && (
            <a 
              href={video.details.builderPackUrl}
              target="_blank"
              rel="noopener noreferrer"
              style={{
                background: 'linear-gradient(135deg, #667eea, #764ba2)',
                color: 'white',
                padding: '12px 24px',
                borderRadius: '24px',
                textDecoration: 'none',
                fontWeight: 'bold',
                fontSize: '0.9rem',
                transition: 'transform 0.2s ease'
              }}
              onMouseEnter={(e) => {
                e.currentTarget.style.transform = 'translateY(-2px)';
              }}
              onMouseLeave={(e) => {
                e.currentTarget.style.transform = 'translateY(0)';
              }}
            >
              🛠️ Get Builder Pack
            </a>
          )}
        </div>

        {/* Close button */}
        <button
          onClick={onClose}
          style={{
            position: 'absolute',
            top: '16px',
            right: '16px',
            background: 'rgba(0, 0, 0, 0.1)',
            border: 'none',
            borderRadius: '50%',
            width: '32px',
            height: '32px',
            cursor: 'pointer',
            fontSize: '1.2rem',
            display: 'flex',
            alignItems: 'center',
            justifyContent: 'center',
            transition: 'background 0.2s ease'
          }}
          onMouseEnter={(e) => {
            e.currentTarget.style.background = 'rgba(0, 0, 0, 0.2)';
          }}
          onMouseLeave={(e) => {
            e.currentTarget.style.background = 'rgba(0, 0, 0, 0.1)';
          }}
        >
          ×
        </button>
      </div>

      <style>{`
        @keyframes modalAppear {
          from {
            opacity: 0;
            transform: scale(0.9);
          }
          to {
            opacity: 1;
            transform: scale(1);
          }
        }
      `}</style>
    </div>
  );
};

export default VideoModal;